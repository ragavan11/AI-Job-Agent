# Copy this file to .env and fill it in. .env is gitignored — never commit real keys.

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=

# SQLite by default. To use Postgres instead: postgresql://user:pass@localhost:5432/jobagent
DATABASE_URL=sqlite:///./data/jobagent.db

# Which provider resume/cover-letter generation uses. One of: anthropic | openai | gemini
AI_PROVIDER=anthropic

# Only the key for your chosen AI_PROVIDER is required — the others can stay blank.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# How often the background job re-fetches and re-scores (minutes)
AUTO_REFRESH_MINUTES=60
ENABLE_SCHEDULER=true

# Application-review posture — see README before changing this
REQUIRE_REVIEW_BEFORE_SUBMIT=true
